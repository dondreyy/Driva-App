# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000
# Local Postgres 16 with PostGIS. See README for the docker command.
DATABASE_URL=postgres://driva:driva@localhost:5432/driva

# At least 32 random characters each. Generate with: openssl rand -base64 48
JWT_SECRET=
OTP_PEPPER=

# AES-256 key for NINs and licence numbers. Generate with: openssl rand -base64 32
# Losing it makes stored NINs unreadable. Keep it in the secrets manager, never in git.
DATA_ENCRYPTION_KEY=

# local keeps photos on this machine (development only). s3 is required in production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage
# Address the apps use to reach this API, for local signed photo links.
PUBLIC_API_URL=http://localhost:3000
# S3_BUCKET=
# AWS_REGION=af-south-1

# dev uses sample places and straight line distances (development only; prices are not real).
# google is required in production: enable Places API (New), Geocoding API and Routes API.
MAPS_PROVIDER=dev
GOOGLE_MAPS_API_KEY=

# console prints login codes to the API log (development only). termii sends real SMS.
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=
# TERMII_BASE_URL=https://api.ng.termii.com

# Comma separated origins allowed to call the API from a browser (local web builds only).
# CORS_ORIGINS=http://localhost:8081,http://localhost:3001

# Admin dashboard (apps/admin): where its server reaches the API.
# DRIVA_API_URL=http://localhost:3000
